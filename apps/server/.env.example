# Postgres (siehe docker-compose.yml). In Produktion Pflicht.
DATABASE_URL=postgres://duel:duel@localhost:5432/duel
# TLS zur Datenbank: disable (lokal) | require | verify (empfohlen für AWS RDS)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Google OAuth Client-ID (Typ "Webanwendung") aus der Google Cloud Console.
# Autorisierte JavaScript-Quellen: http://localhost:5173
GOOGLE_CLIENT_ID=

# Langer, zufälliger String zum Signieren der Session-Cookies (Produktion: mind. 32 Zeichen,
# z. B. "openssl rand -base64 48")
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Öffentliche URL der App (Stripe leitet nach dem Bezahlen hierhin zurück)
APP_URL=http://localhost:5173

# Stripe (Dashboard → Entwickler → API-Schlüssel). Ohne Schlüssel ist das Pro-Abo deaktiviert.
STRIPE_SECRET_KEY=
# Signatur-Secret des Webhook-Endpunkts /api/stripe/webhook (lokal: "stripe listen" zeigt es an)
STRIPE_WEBHOOK_SECRET=
# Optional: ID eines vorhandenen Preises (price_...). Leer = 3 €/Monat wird automatisch verwendet.
STRIPE_PRICE_ID=

# Erlaubt lokal einen Test-Login ohne Google (nur außerhalb von production).
DEV_LOGIN=true

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Migrationen beim Start ausführen (Standard true). false, wenn ein eigener Deploy-Schritt migriert.
RUN_MIGRATIONS=true

# Beim Herunterfahren (Deploy) dürfen laufende Duelle so lange zu Ende gespielt werden.
SHUTDOWN_TIMEOUT_MS=90000

# Bot als Gegner, wenn nach 6–12 s niemand sonst sucht (Standard true)
BOTS_ENABLED=true
