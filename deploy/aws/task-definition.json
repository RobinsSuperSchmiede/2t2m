{
  "family": "2t2m",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/2t2m-ecs-execution",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<wird beim Deploy ersetzt>",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }],
      "stopTimeout": 120,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3001" },
        { "name": "CLIENT_ORIGIN", "value": "https://<DOMAIN>" },
        { "name": "APP_URL", "value": "https://<DOMAIN>" },
        { "name": "DATABASE_SSL", "value": "verify" },
        { "name": "SHUTDOWN_TIMEOUT_MS", "value": "90000" },
        { "name": "LOG_LEVEL", "value": "info" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:2t2m/prod:DATABASE_URL::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:2t2m/prod:JWT_SECRET::" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:2t2m/prod:GOOGLE_CLIENT_ID::" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:2t2m/prod:STRIPE_SECRET_KEY::" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:2t2m/prod:STRIPE_WEBHOOK_SECRET::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/2t2m",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
