# Postgres (siehe docker-compose.yml)
DATABASE_URL=postgres://duel:duel@localhost:5432/duel

# Google OAuth Client-ID (Typ "Webanwendung") aus der Google Cloud Console.
# Autorisierte JavaScript-Quellen: http://localhost:5173
GOOGLE_CLIENT_ID=

# Langer, zufälliger String zum Signieren der Session-Cookies
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Erlaubt lokal einen Test-Login ohne Google (nur außerhalb von production).
DEV_LOGIN=true
